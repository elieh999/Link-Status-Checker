/* Link Status Checker light dashboard theme.
   Keep this file in the same folder as LinkStatusChecker.exe. */

QWidget {
    background: #eaf1fb;
    color: #132033;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background: #eaf1fb;
}

QScrollArea {
    background: transparent;
    border: 0;
}

QFrame#Hero {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1e3a8a,
        stop:0.45 #2563eb,
        stop:0.72 #0891b2,
        stop:1 #14b8a6
    );
    border: 0;
    border-radius: 20px;
}

QLabel#Title {
    background: transparent;
    color: #ffffff;
    font-size: 34px;
    font-weight: 900;
}

QLabel#Subtitle {
    background: transparent;
    color: #e8f4ff;
    font-size: 15px;
    font-weight: 850;
}

QLabel#HeroHint {
    background: transparent;
    color: #cffafe;
    font-size: 13px;
    font-weight: 600;
}

QLabel#MonitorPill {
    background: #fef3c7;
    color: #854d0e;
    border: 1px solid #f59e0b;
    border-radius: 18px;
    padding: 10px 18px;
    font-weight: 900;
}

QLabel {
    background: transparent;
}

QGroupBox {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #f1f8ff,
        stop:1 #e7f0fb
    );
    border: 1px solid #b9cbe2;
    border-radius: 18px;
    margin-top: 16px;
    padding: 17px;
    color: #132033;
    font-weight: 850;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 10px;
    color: #0f3b7a;
    background: #eaf1fb;
    font-size: 14px;
    font-weight: 900;
}

QGroupBox#ControlPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #e6f7ff,
        stop:0.52 #eef3ff,
        stop:1 #e9f7ef
    );
    border: 1px solid #9fc4df;
}

QGroupBox#DashboardPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #e9f7ff,
        stop:1 #f0f7ff
    );
    border: 1px solid #a9c9de;
}

QGroupBox#IisPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #f0f4ff,
        stop:1 #e8f8f4
    );
    border: 1px solid #b6c7dc;
}

QGroupBox#HistoryPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #eef6ff,
        stop:1 #edf2fb
    );
    border: 1px solid #b6c7dc;
}

QGroupBox#DatabasePanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #eaf7ff,
        stop:0.55 #edf7f2,
        stop:1 #f0f4ff
    );
    border: 1px solid #9fc4df;
}

QGroupBox#DatabaseSubPanel {
    background: rgba(255, 255, 255, 150);
    border: 1px solid #b7cbe0;
    border-radius: 14px;
}

QGroupBox#DatabaseSubPanel::title {
    background: #edf7f2;
    color: #0f3b7a;
}

QLabel#DatabaseNote {
    background: #dff7ef;
    color: #14532d;
    border: 1px solid #8bd7b7;
    border-radius: 12px;
    padding: 10px 12px;
    font-weight: 850;
}

QLabel#DatabaseProvider {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #9fc4df;
    border-radius: 13px;
    padding: 9px 13px;
    font-size: 14px;
    font-weight: 900;
}

QCheckBox#DatabaseTrustCheckbox {
    background: transparent;
    color: #16415f;
    font-size: 13px;
    font-weight: 850;
    spacing: 8px;
}

QCheckBox#DatabaseTrustCheckbox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #7fb3d8;
    border-radius: 5px;
    background: #f8fbff;
}

QCheckBox#DatabaseTrustCheckbox::indicator:checked {
    background: #0ea5e9;
    border: 1px solid #0369a1;
}

QLabel#DatabaseStatus {
    background: #dff4ff;
    color: #16415f;
    border: 1px solid #9ed2ef;
    border-radius: 13px;
    padding: 11px 13px;
    font-weight: 850;
}

QLabel#DatabaseSummary {
    background: #e8fff6;
    color: #17433a;
    border: 1px solid #a8dccb;
    border-radius: 13px;
    padding: 11px 13px;
    font-weight: 850;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QTableWidget {
    background: #f8fbff;
    color: #142033;
    border: 1px solid #adc4dc;
    border-radius: 13px;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}

QLineEdit {
    font-size: 15px;
    font-weight: 800;
    min-height: 31px;
    padding: 7px 13px;
}

QSpinBox {
    background: #f8fbff;
    color: #142033;
    border: 0;
    border-radius: 0;
    font-size: 15px;
    font-weight: 750;
    min-width: 150px;
    min-height: 31px;
    padding: 7px 13px;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}

QWidget#NumberStepper {
    background: #f8fbff;
    border: 1px solid #9fbad2;
    border-radius: 13px;
}

QSpinBox#StepperSpin {
    background: transparent;
    color: #142033;
    border: 0;
    padding: 7px 13px;
    font-weight: 800;
}

QPushButton#StepperPlus,
QPushButton#StepperMinus {
    color: #ffffff;
    border-radius: 0;
    padding: 0;
    min-height: 0;
    font-size: 15px;
    font-weight: 900;
}

QPushButton#StepperPlus {
    background: #1d4ed8;
    border-top-right-radius: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 80);
}

QPushButton#StepperMinus {
    background: #0f766e;
    border-bottom-right-radius: 12px;
}

QPushButton#StepperPlus:hover {
    background: #1e40af;
}

QPushButton#StepperMinus:hover {
    background: #0d9488;
}

QLineEdit:focus,
QSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border: 2px solid #2563eb;
    background: #ffffff;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 0;
    height: 0;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover {
    background: #1d4ed8;
}

QSpinBox::down-button:hover {
    background: #0d9488;
}

QPlainTextEdit {
    color: #142033;
    font-size: 13px;
    min-height: 76px;
    padding: 11px 13px;
}

QComboBox {
    color: #142033;
    font-size: 14px;
    font-weight: 800;
    min-height: 31px;
    padding: 7px 35px 7px 13px;
}

QComboBox::drop-down {
    border: 0;
    width: 32px;
}

QPushButton {
    border: 0;
    border-radius: 13px;
    padding: 12px 18px;
    font-weight: 900;
    min-height: 25px;
}

QPushButton#PrimaryButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1d4ed8,
        stop:1 #0891b2
    );
    color: #ffffff;
}

QPushButton#PrimaryButton:hover {
    background: #1e40af;
}

QPushButton#SuccessButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #059669,
        stop:1 #0f766e
    );
    color: #ffffff;
}

QPushButton#SuccessButton:hover {
    background: #047857;
}

QPushButton#DangerButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #f43f5e,
        stop:1 #be123c
    );
    color: #ffffff;
}

QPushButton#DangerButton:hover {
    background: #9f1239;
}

QPushButton#SoftButton {
    background: #dbeafe;
    color: #123b74;
    border: 1px solid #9ab9d9;
}

QPushButton#SoftButton:hover {
    background: #c7ddf7;
    border: 1px solid #5f97d1;
}

QPushButton:disabled {
    background: #aebdd0;
    color: #f8fafc;
    border: 0;
}

QFrame#LinkCard {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #fbfdff,
        stop:1 #edf6ff
    );
    border: 1px solid #b6cbe0;
    border-radius: 17px;
}

QFrame#LinkCard[status="ACTIVE"] {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #ecfdf5,
        stop:1 #e3f7ff
    );
    border: 2px solid #7dd3b0;
}

QFrame#LinkCard[status="INACTIVE"] {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #fff1f2,
        stop:1 #ffe8ef
    );
    border: 2px solid #fb7185;
}

QFrame#LinkCard[status="CHECKING"] {
    background: #eef6ff;
    border: 2px solid #60a5fa;
}

QFrame#LinkCard[selected="true"] {
    background: #eef6ff;
    border: 2px solid #1d4ed8;
}

QLabel#CardTitle {
    color: #0f172a;
    font-size: 15px;
    font-weight: 900;
}

QLabel#CardUrl {
    color: #385672;
    font-size: 12px;
    font-weight: 600;
}

QLabel#CardMeta {
    color: #1f3349;
    font-size: 12px;
    font-weight: 850;
}

QLabel#CardMessage {
    color: #496075;
    font-size: 12px;
    font-weight: 600;
}

QLabel#CardStatusBadge {
    border-radius: 11px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 900;
}

QLabel#IisResult {
    background: #dff4ff;
    color: #16415f;
    border: 1px solid #9ed2ef;
    border-radius: 13px;
    padding: 11px 13px;
    font-weight: 850;
}

QHeaderView::section {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1e40af,
        stop:0.58 #2563eb,
        stop:1 #0891b2
    );
    color: #ffffff;
    border: 0;
    border-right: 1px solid rgba(255, 255, 255, 80);
    padding: 10px;
    font-weight: 900;
}

QTableWidget {
    background: #f8fbff;
    gridline-color: #d9e5f2;
    alternate-background-color: #edf6ff;
    selection-background-color: #bfdbfe;
    selection-color: #102033;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #dce7f2;
}

QScrollBar:vertical {
    background: #dce9f7;
    width: 14px;
    margin: 0;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background: #75b8d8;
    min-height: 34px;
    border-radius: 7px;
}

QScrollBar::handle:vertical:hover {
    background: #2f95c2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #dce9f7;
    height: 14px;
    margin: 0;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background: #75b8d8;
    min-width: 34px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal:hover {
    background: #2f95c2;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Version 3 workspace */
QWidget#AppShell,
QWidget#PageCanvas,
QStackedWidget#PageStack {
    background: #edf3fa;
}

QFrame#Sidebar {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #123b66,
        stop:0.55 #125f75,
        stop:1 #147a72
    );
    border: 0;
}

QLabel#SidebarBrand {
    color: #ffffff;
    font-size: 19px;
    font-weight: 900;
}

QLabel#SidebarTagline {
    color: #ccecf1;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#NavButton {
    background: transparent;
    color: #dff4f7;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 11px 13px;
    text-align: left;
    font-size: 13px;
    font-weight: 750;
}

QPushButton#NavButton:hover {
    background: rgba(255, 255, 255, 28);
    border-color: rgba(255, 255, 255, 44);
}

QPushButton#NavButton:checked {
    background: #ffffff;
    color: #124b68;
    border-color: #b9e5e8;
}

QFrame#PageHeader {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #dff1ff,
        stop:0.55 #e4f7f3,
        stop:1 #eef0ff
    );
    border: 1px solid #b8d3e8;
    border-radius: 8px;
}

QLabel#PageTitle {
    color: #14365b;
    font-size: 25px;
    font-weight: 900;
}

QLabel#PageDescription {
    color: #48677f;
    font-size: 13px;
    font-weight: 600;
}

QFrame#MetricCard {
    background: #f9fcff;
    border: 1px solid #c3d5e6;
    border-left: 5px solid #2f7ed8;
    border-radius: 7px;
    min-width: 132px;
}

QFrame#MetricCard[accent="green"] { border-left-color: #0e9f6e; background: #effbf6; }
QFrame#MetricCard[accent="amber"] { border-left-color: #d97706; background: #fff8e8; }
QFrame#MetricCard[accent="red"] { border-left-color: #dc2626; background: #fff2f3; }
QFrame#MetricCard[accent="blue"] { border-left-color: #2563eb; background: #eff5ff; }
QFrame#MetricCard[accent="slate"] { border-left-color: #64748b; background: #f4f7fa; }
QFrame#MetricCard[accent="teal"] { border-left-color: #0f8f83; background: #ecfbf8; }
QFrame#MetricCard[accent="violet"] { border-left-color: #7c5fd1; background: #f5f1ff; }
QFrame#MetricCard[accent="cyan"] { border-left-color: #0891b2; background: #edfbff; }
QFrame#MetricCard[accent="rose"] { border-left-color: #e11d48; background: #fff1f5; }
QFrame#MetricCard[accent="gold"] { border-left-color: #ca8a04; background: #fff9e5; }

QLabel#MetricTitle {
    color: #526980;
    font-size: 11px;
    font-weight: 800;
}

QLabel#MetricValue {
    color: #162c45;
    font-size: 24px;
    font-weight: 900;
}

QLabel#MetricNote {
    color: #718398;
    font-size: 10px;
    font-weight: 600;
}

QFrame#OverviewPanel,
QFrame#InputPanel,
QFrame#FilterBar,
QFrame#DashboardPanel,
QFrame#SettingsPanel {
    background: #f8fbff;
    border: 1px solid #bfd2e4;
    border-radius: 8px;
}

QFrame#OverviewPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #f7fbff,
        stop:1 #edf7f5
    );
}

QLabel#PanelTitle {
    color: #163b5f;
    font-size: 15px;
    font-weight: 900;
}

QLabel#PanelBody,
QLabel#OverviewFooter,
QLabel#SettingsNote {
    color: #4c657d;
    font-size: 12px;
    font-weight: 600;
}

QLabel#OverviewFooter,
QLabel#SettingsNote {
    background: #e2f1fa;
    border: 1px solid #b9d8e8;
    border-radius: 7px;
    padding: 10px 12px;
}

QLabel#EmptyState {
    background: #edf6fb;
    color: #557087;
    border: 1px dashed #9ebdd2;
    border-radius: 7px;
    min-height: 110px;
    font-size: 14px;
    font-weight: 700;
}

QFrame#LinkCard {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #f9fcff,
        stop:1 #eef6fb
    );
    border: 1px solid #b9cfe1;
    border-radius: 8px;
}

QFrame#LinkCard[healthStatus="HEALTHY"] {
    background: #f0fbf6;
    border: 2px solid #72cdae;
}

QFrame#LinkCard[healthStatus="DEGRADED"] {
    background: #fff9ea;
    border: 2px solid #e5b65d;
}

QFrame#LinkCard[healthStatus="UNHEALTHY"] {
    background: #fff3f4;
    border: 2px solid #e9828b;
}

QFrame#LinkCard[healthStatus="MAINTENANCE"] {
    background: #f0f5ff;
    border: 2px solid #83a8ee;
}

QFrame#LinkCard[healthStatus="UNKNOWN"] {
    background: #f4f7fa;
    border: 2px solid #a9b5c3;
}

QFrame#LinkCard[selected="true"] {
    border: 2px solid #146fc2;
}

QLabel#CardUrl {
    color: #1268b3;
    font-size: 12px;
    font-weight: 750;
    text-decoration: underline;
}

QLabel#CardUrl:hover {
    color: #0a4b89;
}

QWidget#StatusStrip {
    background: transparent;
}

QToolButton#StatusChoice {
    background: #edf2f7;
    color: #77889a;
    border: 1px solid #d0dbe6;
    border-radius: 6px;
    padding: 6px 7px;
    min-height: 20px;
    font-size: 10px;
    font-weight: 750;
}

QToolButton#StatusChoice:hover {
    background: #e2ebf3;
    color: #435a70;
}

QToolButton#StatusChoice[active="true"][healthStatus="HEALTHY"] {
    background: #0e9f6e;
    color: #ffffff;
    border: 2px solid #087f58;
}

QToolButton#StatusChoice[active="true"][healthStatus="DEGRADED"] {
    background: #d97706;
    color: #ffffff;
    border: 2px solid #ad5f03;
}

QToolButton#StatusChoice[active="true"][healthStatus="UNHEALTHY"] {
    background: #dc2626;
    color: #ffffff;
    border: 2px solid #b91c1c;
}

QToolButton#StatusChoice[active="true"][healthStatus="MAINTENANCE"] {
    background: #2563eb;
    color: #ffffff;
    border: 2px solid #1d4ed8;
}

QToolButton#StatusChoice[active="true"][healthStatus="UNKNOWN"] {
    background: #64748b;
    color: #ffffff;
    border: 2px solid #475569;
}

QPushButton#DetailsButton {
    background: #dceaf5;
    color: #174d72;
    border: 1px solid #9fc1d8;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 22px;
    font-size: 10px;
}

QWidget#Sparkline {
    background: #eaf4fb;
    border: 1px solid #c2d8e7;
    border-radius: 6px;
}

QLabel#PageSummary {
    color: #49647d;
    font-weight: 800;
}
